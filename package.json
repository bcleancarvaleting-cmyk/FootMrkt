{
  "name": "matchx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && tsx prisma/seed.ts",
    "jobs": "tsx scripts/jobs.ts",
    "postinstall": "prisma generate",
    "images:import": "tsx scripts/import-player-images.ts",
    "data:import": "python3 scripts/import_wikipedia.py",
    "values:import": "tsx scripts/import-market-values.ts",
    "values:estimate": "tsx scripts/estimate-values.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "html-to-image": "^1.11.11",
    "jszip": "^3.10.1",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
