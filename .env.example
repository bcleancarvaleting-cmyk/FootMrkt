# PostgreSQL connection string
DATABASE_URL="postgresql://matchx:matchx@localhost:5432/matchx?schema=public"
# Used to sign session cookies. Use a long random value outside development.
SESSION_SECRET="change-me"
# Feature flags (see src/config/flags.ts). All default to OFF.
# FLAG_PAID_PACKS=false
# FLAG_MARKET=false
# FLAG_DEV_TOOLS=true

# Transactional email (Resend). Without a key, emails are logged in Admin → Emails but not sent.
RESEND_API_KEY=""
EMAIL_FROM="MATCHX <hello@your-domain>"
# Public address of the site, used in email links.
APP_URL="http://localhost:3000"

# Live football data (API-Football / api-sports.io). Leave empty to keep using simulated data.
API_FOOTBALL_KEY=""

# Card payments. "sandbox" (default) or "stripe". Stripe needs both keys below.
PAYMENTS_PROVIDER="sandbox"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Production
APP_URL="http://localhost:3000"
CRON_SECRET=""
IP_HASH_SALT=""
ERROR_WEBHOOK_URL=""

# Push notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@matchx.app"
